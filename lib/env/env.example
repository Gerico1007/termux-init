# Forest of Gerico — Termux device environment template
# Auto-sourced by ~/.bashrc.d/00-core.sh if present at ~/.env
#
# Copy to ~/.env and fill in keys; ~/.env is gitignored on the device.

# ── Anthropic / Claude Code ─────────────────────────────────────────
# Claude Code reads its own auth from `claude login`; no API key needed here unless
# you're using the raw SDK.
# ANTHROPIC_API_KEY=

# ── Groq Whisper (used by gmusic-webportals) ────────────────────────
# Free tier — get a key at https://console.groq.com/
GROQ_API_KEY=

# ── Forest registry override (optional) ─────────────────────────────
# Default points at Eury via Tailscale. Override for testing.
# Plain http:// is intentional — Tailscale provides E2E encryption already and
# the registry binds only to the tailnet interface (see DESIGN.md).
# FOREST_REGISTRY_URL=http://eury.ferret-harmonic.ts.net:8771
