#!/usr/bin/env bash
# forest-status — Forest of Gerico mesh status.
# Asks the forest-registry for the current node roster (including platform +
# ssh_port), then probes each node with a real SSH handshake. iOS nodes (no
# sshd) are labeled accordingly. Falls back to a fixed roster if the registry
# is unreachable.
#
# A command on PATH since 0.3.0, so it works whatever owns ~/.bashrc
# (Gerico1007/termux-init#4). FOREST_REGISTRY_URL in the environment or in
# ~/.env overrides the registry address. Only that one line of ~/.env is read:
# the file is never sourced, because on the phones it holds other tools'
# secrets and lines that are not shell.

if [ -z "${FOREST_REGISTRY_URL:-}" ] && [ -r "$HOME/.env" ]; then
  FOREST_REGISTRY_URL=$(grep -E '^[[:space:]]*(export[[:space:]]+)?FOREST_REGISTRY_URL=' "$HOME/.env" \
    | tail -n 1 | cut -d= -f2- | tr -d "\"'\r" | sed 's/[[:space:]]*$//')
fi
registry="${FOREST_REGISTRY_URL:-http://eury.ferret-harmonic.ts.net:8773}"

if command -v jq >/dev/null 2>&1 \
    && nodes_json=$(curl -sf --max-time 3 "$registry/nodes" 2>/dev/null); then
  echo "$nodes_json" | jq -r '.nodes[] | "\(.hostname)\t\(.platform // "?")\t\(.ssh_port // "-")"' \
    | while IFS=$'\t' read -r host platform port; do
      printf "%-10s [%-6s] " "$host" "$platform"
      if [ "$port" = "-" ] || [ -z "$port" ]; then
        echo "no sshd"
      elif ssh -n -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new \
              "$host" true 2>/dev/null; then
        # -n redirects ssh's stdin from /dev/null. Without it ssh would slurp
        # the rest of the while-read pipe input on its first success, and the
        # loop would silently exit after the first reachable node.
        echo "ssh ok"
      else
        echo "ssh unreachable"
      fi
    done
else
  echo "⚠ registry $registry unreachable; probing fallback roster via SSH config"
  for n in eury larix tilia; do
    printf "%-10s          " "$n"
    ssh -n -o BatchMode=yes -o ConnectTimeout=3 "$n" true 2>/dev/null \
      && echo "ssh ok" || echo "ssh unreachable"
  done
fi
